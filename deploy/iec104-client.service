[Unit]
Description=IEC 60870-5-104 client, dials MSL5
Documentation=https://github.com/Mhd25OrCode/IEC104_Go
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iec104
Group=iec104
WorkingDirectory=/opt/iec104
ExecStart=/opt/iec104/iec104-client -msl5-host 127.0.0.1 -msl5-port 2404 -ca 1
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
