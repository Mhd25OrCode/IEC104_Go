[Unit]
Description=IEC 60870-5-104 outstation (server)
Documentation=https://github.com/Mhd25OrCode/IEC104_Go
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iec104
Group=iec104
WorkingDirectory=/opt/iec104
ExecStart=/opt/iec104/iec104-server -host 0.0.0.0 -port 2404
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
